{
  "_comment": "Role -> where to look in the device-preset catalog (folder = '<Engine>/<Category>' as Live's browser files it), descriptive terms that lift a candidate, and plugin suggestions used only when the plugin is listed in Live's browser.",
  "roles": {
    "drums": {
      "browser_path": "drums",
      "folders": [],
      "secondary_folders": [],
      "terms": ["kit"],
      "plugins": []
