    "bass": {
      "folders": ["Bass"],
      "secondary_folders": [],
      "terms": ["bass"],
      "feature_terms": [
        {"when": {"onsets_per_beat_min": 1.0, "pitch_range_min": 12},
         "boost": ["analog", "synth", "finger", "pick", "moog", "acid", "funk", "walking"],
         "avoid": ["sub", "808", "sine", "boom"],
         "why": "a moving line, not a static sub"},
        {"when": {"onsets_per_beat_max": 0.999},
         "boost": ["sub", "808", "sine", "deep"],
         "why": "sparse low notes suit a sub"}
      ],
      "plugins": [
        {"name": "Serum 2", "why": "wavetable/analog bass with heavy modulation"},
        {"name": "Massive", "why": "classic synth bass"}
      ]
    },
